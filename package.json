{
  "name": "rbi-hub-code-challenge",
  "version": "1.0.0",
  "description": "Playwright TypeScript Automation Framework for RBI Hub Calculator Challenge",
  "author": "Vishnukumar Pujari",
  "private": true,
  "scripts": {
    "test": "playwright test",

    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:boundary": "playwright test --grep @boundary",
    "test:state": "playwright test --grep @state",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",

    "test:headed": "playwright test --headed",

    "report": "playwright show-report",

    "lint:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}